# Server Configuration
PORT=3000
NODE_ENV=development

# Cryptographic Signing & Server-Only Secrets
# CRITICAL: NEVER expose these with client-public env prefixes. Store exclusively in Vercel/Cloud Run Environment Variables.
SESSION_HMAC_SECRET=
STREAM_HMAC_SECRET=
BACKUP_SIGNING_SECRET=

# Optional Cache / Multi-Instance Redis URL (Server-Only)
REDIS_URL=

# Gemini API Key (Server-Only; never exposed to client bundle)
GEMINI_API_KEY=
