# Server Configuration
PORT=3000
NODE_ENV=development

# Cryptographic Signing & Session Secrets (Never commit real values; use Vault/Cloud Run Secrets)
SESSION_HMAC_SECRET=
STREAM_HMAC_SECRET=
BACKUP_SIGNING_SECRET=

# Optional Cache / Multi-Instance Redis URL
REDIS_URL=

# Gemini API Key (Injected via environment / Secret Manager)
GEMINI_API_KEY=
