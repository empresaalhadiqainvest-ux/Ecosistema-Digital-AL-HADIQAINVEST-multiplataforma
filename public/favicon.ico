<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <radialGradient id="emeraldBg" cx="50%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#0a3528"/>
      <stop offset="50%" stop-color="#062319"/>
      <stop offset="100%" stop-color="#02120c"/>
    </radialGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fdf3c7"/>
      <stop offset="35%" stop-color="#f59e0b"/>
      <stop offset="70%" stop-color="#d97706"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24"/>
      <stop offset="50%" stop-color="#d4af37"/>
      <stop offset="100%" stop-color="#78350f"/>
    </linearGradient>
    <filter id="goldGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="6" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Fondo Circular Esmeralda Profundo -->
  <circle cx="256" cy="256" r="248" fill="url(#emeraldBg)"/>

  <!-- Anillo Exterior Dorado Institucional -->
  <circle cx="256" cy="256" r="236" fill="none" stroke="url(#ringGrad)" stroke-width="12" filter="url(#goldGlow)"/>
  <circle cx="256" cy="256" r="218" fill="none" stroke="url(#goldGrad)" stroke-width="2" stroke-dasharray="6,4" opacity="0.7"/>

  <!-- Corona y Melena del León Institucional AL-HADIQA INVEST -->
  <g fill="url(#goldGrad)" filter="url(#goldGlow)">
    <!-- Corona de 3 Puntas -->
    <path d="M196 142 L220 180 L256 128 L292 180 L316 142 L326 200 L186 200 Z" />
    <circle cx="196" cy="136" r="7" />
    <circle cx="256" cy="120" r="9" />
    <circle cx="316" cy="136" r="7" />

    <!-- Melena y Cabeza de León Heráldico -->
    <path d="M256 195 C220 195 180 220 170 265 C160 308 185 348 205 365 C220 378 238 392 256 405 C274 392 292 378 307 365 C327 348 352 308 342 265 C332 220 292 195 256 195 Z" />

    <!-- Detalles del Rostro y Fauces (Máscara Negativa en Esmeralda) -->
    <path d="M256 260 L242 285 L270 285 Z" fill="#062319" />
    <!-- Ojos Felinos Determinados -->
    <path d="M218 262 C225 255 235 258 240 264 C234 268 224 268 218 262 Z" fill="#02120c" />
    <path d="M294 262 C287 255 277 258 272 264 C278 268 288 268 294 262 Z" fill="#02120c" />

    <!-- Hocico y Barba Institucional -->
    <path d="M248 292 L264 292 L256 308 Z" fill="#062319" />
    <path d="M236 320 C246 328 266 328 276 320 C270 338 242 338 236 320 Z" fill="#062319" />
  </g>

  <!-- Puntos Cardinales / Estrellas de Excelencia -->
  <circle cx="256" cy="48" r="5" fill="#fbbf24" />
  <circle cx="256" cy="464" r="5" fill="#fbbf24" />
  <circle cx="48" cy="256" r="5" fill="#fbbf24" />
  <circle cx="464" cy="256" r="5" fill="#fbbf24" />
</svg>
